# Configuração local de desenvolvimento. Copie para .env para alterar algum valor.
# Todos os valores abaixo já são o padrão: o projeto roda sem .env.
# São credenciais locais de exemplo, não secretas. Nunca coloque segredos reais aqui.

POSTGRES_PORT=5432
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=barbearia
POSTGRES_DB=barbearia
REDIS_PORT=6379

# Porta da API em desenvolvimento
PORT=3000

# Identidade e autenticação (feature 002)
# As URLs do banco derivam das variáveis POSTGRES_* acima quando não definidas.
# DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/barbearia
# DATABASE_ADMIN_URL=postgres://barbearia:barbearia@localhost:5432/barbearia
APP_RUNTIME_PASSWORD=app_runtime

# E-mail: Mailpit local (interface em http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025
SMTP_FROM="Barbearia <nao-responder@localhost>"

# Base dos links de convite e de recuperação de senha (admin web)
ADMIN_BASE_URL=http://localhost:3001

# Em produção (HTTPS), o cookie de sessão deve ser Secure
SESSION_COOKIE_SECURE=false
