# Local development configuration. Copy to .env to change any value.
# Every value below is already the default: the project runs without a .env.
# These are example local credentials, not secrets. Never put real secrets here.

POSTGRES_PORT=5432
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=barbearia
POSTGRES_DB=barbearia
REDIS_PORT=6379

# API port in development
PORT=3000

# Identity and authentication (feature 002)
# The database URLs derive from the POSTGRES_* variables above when not set.
# DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/barbearia
# DATABASE_ADMIN_URL=postgres://barbearia:barbearia@localhost:5432/barbearia
APP_RUNTIME_PASSWORD=app_runtime

# E-mail: local Mailpit (UI at http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025
SMTP_FROM="Barbearia <nao-responder@localhost>"

# Base of the invitation and password recovery links (admin web)
ADMIN_BASE_URL=http://localhost:3001

# Per-origin (IP) limit on the public access routes, per minute
# RATE_LIMIT_PER_MINUTE=20

# Minimum response time (ms) of "forgot password": makes existing and missing accounts look alike
# RECOVERY_FLOOR_MS=250

# In production (HTTPS), the session cookie must be Secure
SESSION_COOKIE_SECURE=false
